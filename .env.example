# Neon PostgreSQL (use pooled connection string for Vercel serverless)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret — generate a long random string
JWT_SECRET=change-this-to-a-long-random-secret-string

# Default admin (created via npm run db:seed)
ADMIN_EMAIL=owner@yourcompany.com
ADMIN_PASSWORD=ChangeMe123!

# Optional seed defaults for first company (runtime branding comes from database)
STORE_NAME=Demo Company
COMPANY_SLUG=demo-company
STORE_ADDRESS=
OWNER_EMAIL=owner@yourcompany.com
PRIMARY_COLOR=#1e3a5f
ACCENT_COLOR=#3b82f6

# Super admin (platform operator)
SUPER_ADMIN_EMAIL=admin@hirehub.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# UploadThing — get token from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# Shared HireHub SMTP (one account for all companies — configure once in Vercel)
DEFAULT_SMTP_HOST=
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASS=
DEFAULT_SMTP_SECURE=false
DEFAULT_FROM_EMAIL=notifications@hirehub.app
