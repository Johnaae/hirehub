# Neon PostgreSQL (use pooled connection string for Vercel serverless)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret — generate a long random string
JWT_SECRET=change-this-to-a-long-random-secret-string

# Default admin (created via npm run db:seed)
ADMIN_EMAIL=owner@theupsstore.com
ADMIN_PASSWORD=ChangeMe123!

# Store configuration
STORE_NAME=The UPS Store Hiring Portal
STORE_ADDRESS=123 Main Street, Your City, ST 12345
OWNER_EMAIL=owner@theupsstore.com
PRIMARY_COLOR=#351C15
ACCENT_COLOR=#FFB500

# UploadThing — get token from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# SMTP (optional — leave blank to disable email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
